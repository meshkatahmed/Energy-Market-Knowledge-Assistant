# Required: Google AI API Key for Gemini
GOOGLE_API_KEY="your_api_key_here"

# Optional: Vector Store Provider (Default: chroma)
# Supported: chroma (milvus ready)
VECTOR_STORE_TYPE=chroma

# Optional: LLM Provider (Default: google)
# Supported: google
LLM_PROVIDER=google

# Optional: Embedding Provider (Default: fastembed)
# Supported: fastembed
EMBEDDING_PROVIDER=fastembed

# Frontend Configuration
VITE_API_URL=http://localhost:8000
